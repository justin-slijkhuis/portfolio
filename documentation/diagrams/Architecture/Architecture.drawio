        <mxCell id="vQJH2k5jHzZeBWDmTKOx-72" value="Performs GET, POST, PATCH and DELETE requests" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;spacingLeft=20;spacingRight=20;spacingTop=5;" parent="1" vertex="1">
