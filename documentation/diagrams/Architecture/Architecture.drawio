        <mxCell id="vQJH2k5jHzZeBWDmTKOx-43" value="Performs SELECT, INSERT, UPDATE and DELETE statements" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;spacingLeft=20;spacingRight=20;spacingTop=5;" parent="1" vertex="1">
