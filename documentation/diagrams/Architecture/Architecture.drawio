        <mxCell id="vQJH2k5jHzZeBWDmTKOx-160" value="Performs SELECT, INSERT, UPDATE and DELETE statements" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;spacingLeft=20;spacingRight=20;spacingTop=5;" parent="1" vertex="1">
          <mxGeometry x="1993.5" y="3203" width="205" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-161" value="Improved variant of architecture 3.1 which introduces a new website for the components. The components will be retrieved by both websites using module federation. This allows both websites to have the same components at all times meaning no inconsistencies.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Advantages compared to 3.1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;+ The websites don&#39;t need to update dependencies meaning it is always up to date causing no inconsistencies between posts.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Disadvantages compared to 3.1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Adds another website that needs to be deployed which makes the release proces more complex.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Both the Portfolio and CMS website will fail if the component website is offline.&lt;br&gt;&lt;/span&gt;- Another container needs to be active with the components for both websites to work which increases development complexity a bit.&lt;/div&gt;&lt;div&gt;- Adds the complexity of working with module federation.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1692" y="2390" width="750" height="260" as="geometry" />
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-163" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="vQJH2k5jHzZeBWDmTKOx-143" target="vQJH2k5jHzZeBWDmTKOx-165" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1973.5" y="2928" as="targetPoint" />
          </mxGeometry>
