        <mxCell id="vQJH2k5jHzZeBWDmTKOx-80" value="Architecture 3.0" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=25;" parent="1" vertex="1">
