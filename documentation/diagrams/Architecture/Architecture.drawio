        <mxCell id="vQJH2k5jHzZeBWDmTKOx-132" value="Same architecture as 3.0, but now there is a component library which each website retrieves from GitHub packages of my repository. This allows both websites to have the same components which can be used for the Posts editor.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Advantages compared to 3.0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;+ Components are shared meaning we won&#39;t have to copy paste anything.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Disadvantages compared to 3.0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Requires each website to update their dependencies which could cause the Portfolio posts to be different than the CMS posts.&lt;/div&gt;&lt;div&gt;- The library needs to be published and gathered which adds more complexity to the development and release proces.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1693" y="1220" width="750" height="260" as="geometry" />
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-133" value="Component library package" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1934.5" y="1758" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="vQJH2k5jHzZeBWDmTKOx-114" target="vQJH2k5jHzZeBWDmTKOx-133" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-198" value="Retrieve components package" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="vQJH2k5jHzZeBWDmTKOx-134" vertex="1" connectable="0">
          <mxGeometry x="-0.156" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vQJH2k5jHzZeBWDmTKOx-135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="vQJH2k5jHzZeBWDmTKOx-125" target="vQJH2k5jHzZeBWDmTKOx-133" edge="1">
